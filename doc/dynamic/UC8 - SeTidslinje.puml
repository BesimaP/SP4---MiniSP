@startuml
!pragma layout smetana

title UC8: SeTidslinje

actor "Patient" as u
participant "SeTidslinjeView" as v
participant "SeTidslinjeController" as c
participant "Event" as m
database "SQLite" as db

u -> v : Åbner tidslinjeskærm
v -> c : initialize()
c -> db : SELECT * FROM event WHERE journey_id = ? ORDER BY date ASC
db --> c : ResultSet

alt Ingen hændelser findes
  c --> v : visTomBesked()
  v --> u : "Tidslinjen er tom"
else Hændelser findes
  c -> m : new Event(date, type, description)
  c --> v : visHændelser()
  v --> u : Viser alle hændelser kronologisk
end

u -> v : Klikker på en hændelse
v -> c : handleSelectEvent()
c --> v : visDetaljer()
v --> u : Viser detaljer for hændelsen

@enduml