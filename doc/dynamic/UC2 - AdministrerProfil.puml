@startuml
!pragma layout smetana

title UC2: ManageProfile

actor "Patient" as u
participant "ProfileView" as v
participant "ManageProfileController" as c
participant "Patient" as m
database "SQLite" as db

u -> v : Clicks Create Account
v -> c : handleCreatePatient()
c --> v : showCreateScreen()
v --> u : Shows screen with fields

u -> v : Fills in name, dateOfBirth, diagnosis, username, password
u -> v : Clicks Save
v -> c : handleSave()

alt Fields are empty
  c --> v : showError()
  v --> u : "One or more required fields are empty"
else Username already in use
  c -> db : SELECT * FROM patient WHERE username = ?
  db --> c : ResultSet not empty
  c --> v : showError()
  v --> u : "Username already in use"
else All OK
  c -> m : new Patient(name, dateOfBirth, diagnosis, username, password)
  c -> db : INSERT INTO patient VALUES (?, ?, ?, ?, ?)
  db --> c : OK
  c --> v : showJourneyTypeView()
  v --> u : Shows journey type selection
end

@enduml