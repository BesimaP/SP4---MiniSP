@startuml
!pragma layout smetana

title UC5: Appointment

actor "Patient" as u
participant "AppointmentView" as v
participant "AppointmentController" as c
participant "Appointment" as m
database "SQLite" as db

u -> v : Opens appointment screen
v -> c : show(stage)
c -> db : SELECT * FROM appointment WHERE journey_id = ?
db --> c : ResultSet
c --> v : showAppointments()
v --> u : Shows upcoming appointments

u -> v : Clicks Add Appointment
c --> v : showCreateAppointmentScreen()
v --> u : Shows screen with fields

u -> v : Fills in date, type and location
u -> v : Clicks Save
v -> c : handleSave()

alt Fields are empty
  c --> v : showError()
  v --> u : "One or more required fields are empty"
else All OK
  c -> m : new Appointment(date, type, location)
  c -> db : INSERT INTO appointment VALUES (?, ?, ?, ?)
  db --> c : OK
  c --> v : showUpdatedList()
  v --> u : List updated
end

u -> v : Marks appointment as completed
v -> c : handleMarkCompleted()
c -> db : UPDATE appointment SET completed = 1 WHERE id = ?
db --> c : OK
c --> v : showUpdatedList()
v --> u : Appointment marked as completed

@enduml