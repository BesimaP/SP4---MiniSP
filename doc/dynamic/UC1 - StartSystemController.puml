@startuml
!pragma layout smetana

title UC1: StartSystem

actor "Patient" as u
participant "StartSystemView" as v
participant "StartSystemController" as c
participant "Patient" as m
database "SQLite" as db

u -> v : Opens application
v -> c : show(stage)
v --> u : Shows login screen

u -> v : Fills in username and password
u -> v : Clicks Log in
v -> c : handleLogin(username, password)
c -> db : SELECT * FROM patient WHERE username = ? AND password = ?
db --> c : ResultSet

alt Patient found
  c -> m : new Patient(id, name, dateOfBirth, diagnosis, username, password)
  c -> db : SELECT * FROM journey WHERE patient_id = ? AND status = 'ACTIVE'
  db --> c : ResultSet

  alt Has active journey
    c --> v : showDashboard()
    v --> u : Shows dashboard
  else No active journey
    c --> v : showJourneyTypeView()
    v --> u : Shows journey type selection
  end

else Patient not found
  c --> v : showError()
  v --> u : "Wrong username or password"
end

alt Fields are empty
  c --> v : showError()
  v --> u : "Please fill in all fields"
end

alt Database error
  c --> v : showError()
  v --> u : "Could not read database"
end

@enduml