@startuml
!pragma layout smetana

title UC4: StartNyRunde

actor "Patient" as u
participant "StartNyRundeView" as v
participant "StartNyRundeController" as c
participant "FertilityJourney" as m
database "SQLite" as db

u -> v : Klikker Start Ny Runde
v -> c : handleStartRound()

c -> db : SELECT * FROM fertility_journey WHERE status = 'ACTIVE'
db --> c : ResultSet

alt Runde allerede aktiv
  c --> v : visFejlbesked()
  v --> u : "Der er allerede en aktiv runde"
else Alt OK
  c --> v : visStartRundeSkærm()
  v --> u : Viser skærm til ny IVF-runde
  u -> v : Udfylder felterne
  u -> v : Klikker Start Runde
  v -> c : handleSave()
  c -> m : new FertilityJourney(roundNumber, startDate)
  c -> db : INSERT INTO fertility_journey VALUES (?, ?, ?)
  db --> c : OK
  c --> v : visDashboard()
  v --> u : Dashboard opdateres med ny runde
end

@enduml