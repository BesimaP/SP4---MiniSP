@startuml
!pragma layout smetana

title UC4: NewRound

actor "Patient" as u
participant "NewRoundView" as v
participant "NewRoundController" as c
participant "FertilityJourney" as m
database "SQLite" as db

u -> v : Clicks Start New Round
v --> u : Shows screen for new IVF round

u -> v : Fills in round number
u -> v : Clicks Start Round
v -> c : handleStartRound(roundNumber)

alt Round number is empty
  c --> v : showError()
  v --> u : "Please fill in round number"
else All OK
  c -> db : INSERT INTO fertility_journey (journey_id, roundNumber, result) VALUES (?, ?, ?)
  db --> c : OK
  c -> db : INSERT INTO event (journey_id, date, type, description) VALUES (?, ?, ?, ?)
  db --> c : OK
  c --> v : showDashboard()
  v --> u : Dashboard updated with new round
end

@enduml