@startuml
!pragma layout smetana

title UC1: StartSystem

actor "Patient" as u
participant "StartSystemView" as v
participant "StartSystemController" as c
participant "Patient" as m
database "SQLite" as db

u -> v : Åbner applikationen
v -> c : initialize()
c -> db : SELECT * FROM patient WHERE username = ? AND password = ?
db --> c : ResultSet

alt Patient findes
  c -> m : new Patient(name, dateOfBirth, diagnosis)
  c --> v : visDashboard()
  v --> u : Viser dashboard
else Patient findes ikke
  c --> v : visLoginSkærm()
  v --> u : Viser login-skærm
end

alt Forkert login
  c --> v : visFejlbesked()
  v --> u : "Forkert brugernavn eller adgangskode"
end

alt Database fejl
  c --> v : visFejlbesked()
  v --> u : "Databasen kan ikke læses"
end

@enduml