@startuml
!pragma layout smetana

actor "Patient" as u

usecase "UC1: StartSystem" as UC1
usecase "UC2: ManageProfile" as UC2
usecase "UC3: JourneyType" as UC3

rectangle "Fertility Journey" {
  usecase "UC4: NewRound" as UC4
  usecase "UC5: Appointment" as UC5
  usecase "UC6: HormoneLog" as UC6
  usecase "UC7: MedicationLog" as UC7
  usecase "UC8: Timeline" as UC8
  usecase "UC9: Diary" as UC9
  usecase "UC10: RoundHistory" as UC10
  usecase "UC11: EndRound" as UC11
}

u --> UC1

UC1 --> UC2
UC1 --> UC3
UC2 --> UC3
UC3 --> UC4
UC4 --> UC5
UC4 --> UC6
UC4 --> UC7
UC4 --> UC8
UC4 --> UC9
UC4 --> UC10
UC4 --> UC11

@enduml